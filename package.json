{
  "name": "fit4110-lab05-camera-stream-compose",
  "version": "0.5.0",
  "description": "FIT4110 Lab 05 - Docker Compose readiness and end-to-end verification for Camera Stream",
  "private": true,
  "scripts": {
    "mock:camera": "prism mock contracts/camera-stream.openapi.yaml --host 0.0.0.0 --port 4010",
    "mock:iot": "npm run mock:camera",
    "lint:openapi": "spectral lint contracts/*.yaml",
    "test:compose": "newman run postman/collections/FIT4110_lab05_camera_compose.postman_collection.json -e postman/environments/FIT4110_lab05_local.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export reports/newman-lab05-compose.xml --reporter-htmlextra-export reports/newman-lab05-compose.html"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.10.0",
    "@stoplight/spectral-cli": "^6.13.1",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "wait-on": "^8.0.1"
  }
}
